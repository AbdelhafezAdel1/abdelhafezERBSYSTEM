{
    "version": 2,
    "builds": [
        {
            "src": "backend/app.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "backend/app.js"
        },
        {
            "src": "/auth/(.*)",
            "dest": "backend/app.js"
        },
        {
            "src": "/css/(.*)",
            "dest": "frontend/css/$1"
        },
        {
            "src": "/js/(.*)",
            "dest": "frontend/js/$1"
        },
        {
            "src": "/images/(.*)",
            "dest": "frontend/images/$1"
        },
        {
            "src": "/login.html",
            "dest": "login.html"
        },
        {
            "src": "/register.html",
            "dest": "register.html"
        },
        {
            "src": "/",
            "dest": "index.html"
        },
        {
            "src": "/(.*)",
            "dest": "/$1"
        }
    ],
    "outputDirectory": ".",
    "framework": null
}