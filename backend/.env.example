# Database Configuration
# For Supabase Pooler (Recommended for Render)
DATABASE_URL=postgresql://postgres:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:6543/postgres

# Alternative: Direct connection (fallback)
# DATABASE_URL=postgresql://postgres:PASSWORD@aws-1-ap-south-1.db.supabase.com:5432/postgres

# Option 2: Individual parameters (alternative)
# DB_HOST=aws-1-ap-south-1.pooler.supabase.com
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_NAME=postgres
# DB_PORT=6543

# Application Configuration
SESSION_SECRET=super_secret_session_key_change_this_in_production
NODE_ENV=production
PORT=3100

# For development
# NODE_ENV=development
# PORT=3100
